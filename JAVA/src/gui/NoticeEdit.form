<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.NoticeEdit">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="570"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="43159" binding="titlePanel" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-5796488"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="aee90" class="javax.swing.JLabel" binding="title">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false">
                <preferred-size width="301" height="20"/>
              </grid>
            </constraints>
            <properties>
              <enabled value="true"/>
              <font size="16"/>
              <foreground color="-14083058"/>
              <text value="Edit Notices"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="7b77f" binding="contentPanel" layout-manager="GridLayoutManager" row-count="7" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
