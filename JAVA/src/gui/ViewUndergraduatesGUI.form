<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.ViewUndergraduatesGUI">
  <grid id="27dc6" binding="mainPanel" layout-manager="BorderLayout" hgap="0" vgap="0">
    <constraints>
      <xy x="20" y="20" width="500" height="400"/>
    </constraints>
    <properties>
      <enabled value="true"/>
    </properties>
    <border type="none"/>
    <children>
      <grid id="241ea" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="10" left="10" bottom="10" right="10"/>
        <constraints border-constraint="North"/>
        <properties>
          <background color="-5796488"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="67ec5" class="javax.swing.JLabel" binding="title">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <enabled value="true"/>
              <font size="16"/>
              <foreground color="-14083058"/>
              <text value="Undergraduates"/>
            </properties>
          </component>
        </children>
      </grid>
      <scrollpane id="5e4e8" binding="scrollPanel">
        <constraints border-constraint="Center"/>
        <properties/>
        <border type="none"/>
        <children>
          <component id="a9c0b" class="javax.swing.JTable" binding="table">
            <constraints/>
            <properties>
              <autoCreateColumnsFromModel value="true"/>
              <autoCreateRowSorter value="true"/>
              <autoResizeMode value="1"/>
              <editingColumn value="3"/>
              <editingRow value="3"/>
              <gridColor color="-14083058"/>
              <inheritsPopupMenu value="false"/>
              <intercellSpacing width="6" height="5"/>
              <rowHeight value="30"/>
              <rowMargin value="5"/>
            </properties>
          </component>
        </children>
      </scrollpane>
    </children>
  </grid>
</form>
