<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="gui.NoticePanel">
  <grid id="27dc6" binding="noticesMainPanel" layout-manager="GridLayoutManager" row-count="4" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
    <margin top="0" left="0" bottom="0" right="0"/>
    <constraints>
      <xy x="20" y="20" width="333" height="400"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>
      <grid id="4e69a" layout-manager="BorderLayout" hgap="0" vgap="0">
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <preferred-size width="500" height="30"/>
          </grid>
        </constraints>
        <properties>
          <background color="-5796488"/>
        </properties>
        <border type="none"/>
        <children>
          <component id="1dde3" class="javax.swing.JLabel">
            <constraints border-constraint="Center"/>
            <properties>
              <font size="18" style="1"/>
              <foreground color="-14083058"/>
              <horizontalAlignment value="0"/>
              <horizontalTextPosition value="0"/>
              <text value="Manage Notices"/>
            </properties>
          </component>
        </children>
      </grid>
      <grid id="7a81a" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="3" col-span="1" vsize-policy="3" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false">
            <minimum-size width="200" height="-1"/>
            <preferred-size width="200" height="-1"/>
            <maximum-size width="200" height="-1"/>
          </grid>
        </constraints>
        <properties/>
        <border type="none"/>
        <children>
          <component id="d1a4d" class="javax.swing.JButton" binding="viewNoticesButton" default-binding="true">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <minimum-size width="-1" height="30"/>
                <preferred-size width="-1" height="30"/>
                <maximum-size width="-1" height="30"/>
              </grid>
            </constraints>
            <properties>
              <text value="View Notices"/>
            </properties>
          </component>
          <component id="2bdc3" class="javax.swing.JButton" binding="editNoticesButton" default-binding="true">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
                <minimum-size width="-1" height="30"/>
                <preferred-size width="-1" height="30"/>
                <maximum-size width="-1" height="30"/>
              </grid>
            </constraints>
            <properties>
              <text value="Edit Notices"/>
            </properties>
          </component>
          <component id="50147" class="javax.swing.JButton" binding="createANewNoticeButton">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false">
